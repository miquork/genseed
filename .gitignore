# genseed: outputs and ROOT/ACLiC artefacts.  The histogram and tuple files
# stay out; plots/*.pdf, doc/plots.tex, doc/tables.tex, doc/genseed.pdf and the
# pass-1 correction table text/jec_v1.txt are committed, so that the document
# can be read and rebuilt without the sample (doc/howto.tex).  text/* rather
# than text/: git cannot re-include a file inside an ignored directory.
rootfiles/
text/*
!text/jec_v1.txt
plots/*.crop
*.pcm
*_C.d
*_C.so
*_h.d
*_h.so
doc/*.aux
doc/*.log
doc/*.out
doc/*.toc
doc/*.nav
doc/*.snm
doc/*.synctex.gz

# Claude Code session state
.claude/
